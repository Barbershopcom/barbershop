# Aplicado quando o contexto de build é o root do monorepo
# (Railway: aponta Root Directory pro repo, Dockerfile pra apps/api/Dockerfile).

**/node_modules
**/dist
**/.next
**/.turbo
**/.expo
**/.expo-shared

# Logs
**/*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# Env locais (Railway injeta via dashboard — nunca pra imagem)
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local

# IDE / OS
.git
.gitignore
.vscode
.idea
.DS_Store

# Tests + docs (não entram no runtime)
**/coverage
docs/

# Apps que não fazem parte do build da imagem do API
apps/web
apps/mobile-business
apps/mobile-customer
