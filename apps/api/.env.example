# --- App ---
NODE_ENV=development
PORT=3333

# --- Database (Neon Postgres) ---
# Pooled URL para queries em runtime (pgbouncer compatível)
DATABASE_URL=postgresql://USER:PASS@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&pgbouncer=true&connect_timeout=10
# Direct URL para Prisma Migrate (sem pooler)
DIRECT_URL=postgresql://USER:PASS@HOST.REGION.aws.neon.tech/DB?sslmode=require

# --- Supabase Auth ---
# URL do projeto Supabase (sem barra no final)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# JWKS endpoint padrão do Supabase Auth (RS256)
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# Audience esperado no JWT (Supabase usa 'authenticated' por padrão)
SUPABASE_JWT_AUDIENCE=authenticated
# Issuer esperado
SUPABASE_JWT_ISSUER=https://YOUR-PROJECT.supabase.co/auth/v1

# --- CORS ---
# Origens permitidas separadas por vírgula
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Email (Sprint 5) ---
# Resend free tier: https://resend.com — 3000/mês sem cartão.
# Sem essa chave, EmailService vira no-op (booking continua funcionando).
RESEND_API_KEY=
# Sandbox 'onboarding@resend.dev' só envia pro dono da API key.
# Depois de DNS verification, troca pelo seu domain (ex: no-reply@suabarbearia.com.br).
EMAIL_FROM=onboarding@resend.dev
# URL da web (cancel magic link aponta pra cá)
PUBLIC_WEB_URL=http://localhost:3000
# Secret HMAC pros tokens de cancel. Trocar em prod.
APPOINTMENT_CANCEL_SECRET=dev-only-cancel-secret-CHANGE-IN-PROD-please
