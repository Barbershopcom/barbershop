# --- App ---
NODE_ENV=development
PORT=3333

# --- Database (Neon Postgres) ---
# Pooled URL para queries em runtime (pgbouncer compatível)
DATABASE_URL=postgresql://USER:PASS@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&pgbouncer=true&connect_timeout=10
# Direct URL para Prisma Migrate (sem pooler)
DIRECT_URL=postgresql://USER:PASS@HOST.REGION.aws.neon.tech/DB?sslmode=require

# --- Supabase Auth ---
# URL do projeto Supabase (sem barra no final)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# JWKS endpoint padrão do Supabase Auth (RS256)
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# Audience esperado no JWT (Supabase usa 'authenticated' por padrão)
SUPABASE_JWT_AUDIENCE=authenticated
# Issuer esperado
SUPABASE_JWT_ISSUER=https://YOUR-PROJECT.supabase.co/auth/v1

# --- CORS ---
# Origens permitidas separadas por vírgula
# - 3000: web app (admin + landing)
# - 8081: mobile-customer/web (Expo web)
# - 8082: mobile-business/web (Expo web)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8082

# --- Email (Sprint 5) ---
# Resend free tier: https://resend.com — 3000/mês sem cartão.
# Sem essa chave, EmailService vira no-op (booking continua funcionando).
RESEND_API_KEY=
# Sandbox 'onboarding@resend.dev' só envia pro dono da API key.
# Depois de DNS verification, troca pelo seu domain (ex: no-reply@suabarbearia.com.br).
EMAIL_FROM=onboarding@resend.dev
# URL da web (cancel magic link aponta pra cá)
PUBLIC_WEB_URL=http://localhost:3000
# Secret HMAC pros tokens de cancel. Trocar em prod.
APPOINTMENT_CANCEL_SECRET=dev-only-cancel-secret-CHANGE-IN-PROD-please

# --- Observability (Sprint 13 / ADR-014) ---
# Sem SENTRY_DSN, Sentry vira no-op (booking não trava sem ele).
# DSN do projeto barbearia-api em sentry.io.
SENTRY_DSN=

# --- Pagamento (Sprint 21 / ADR-022) ---
# Provider ativo: 'mock' (dev/test, aprova na hora) | 'mercadopago' (real).
PAYMENT_PROVIDER=mock
# Base da API do Mercado Pago (não muda pra sandbox — o sandbox é por credencial).
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
# URL pública DESTA API (pro notification_url do webhook). Ex em dev: a URL do ngrok.
API_PUBLIC_URL=
# Access token da APLICAÇÃO da plataforma (marketplace). SEGREDO.
# Painel MP → Suas integrações → sua app → Credenciais de TESTE primeiro.
MERCADOPAGO_ACCESS_TOKEN=
# OAuth do MP Connect (conectar a conta do vendedor/barbearia). SEGREDOS.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Pra onde o MP redireciona após autorizar (página do web admin que chama POST /admin/mp/connect).
MERCADOPAGO_OAUTH_REDIRECT_URI=http://localhost:3000/admin/mp/callback
# Secret da assinatura do webhook (Painel MP → Webhooks → sua chave secreta). SEGREDO.
# Em produção é OBRIGATÓRIO — sem ele o webhook rejeita (fail-closed).
MERCADOPAGO_WEBHOOK_SECRET=
