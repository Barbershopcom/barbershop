# Ambiente de TESTE — aponta pro Postgres efêmero do docker-compose.test.yml.
# Sem segredos: credenciais locais descartáveis. Commitado de propósito pra
# o setup de teste ser reprodutível (clone + `pnpm test:db:up` + `pnpm test`).
#
# setup-env.ts carrega este arquivo ANTES do .env, então os testes nunca
# tocam no banco de produção (Neon) por engano.
DATABASE_URL="postgresql://neondb_owner:postgres@localhost:55432/neondb"
DIRECT_URL="postgresql://neondb_owner:postgres@localhost:55432/neondb"
