// Schema Sprint 1 — multi-tenancy completa.
// Hierarquia: Tenant → Organization → Location → Barbershop
//                                                  ├─ BarbershopHours
//                                                  ├─ Service
//                                                  └─ Employee
//
// Tabelas tenant-scoped (com tenant_id desnormalizado e RLS):
//   organizations, locations, barbershops, barbershop_hours, services, employees
//
// Tabelas user-scoped (RLS por app.user_id):
//   app_users, tenant_memberships
//
// Tabela tenants: visível só se user tem membership (RLS via subquery).
//
// Policies em raw SQL migration separada (ver migrations/*_rls_policies/).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Espelho do auth.users do Supabase. ID é o mesmo (sub do JWT).
/// Populado via lazy sync no TenantInterceptor (ON CONFLICT DO NOTHING).
model AppUser {
  id          String   @id @db.Uuid
  email       String?  @unique
  phoneE164   String?  @unique @map("phone_e164")
  displayName String?  @map("display_name")
  cpf         String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships TenantMembership[]
  employees   Employee[]
  customer    Customer?

  @@map("app_users")
}

/// Tenant raiz = unidade de cobrança. 1:1 com Organization no caso comum;
/// estrutura separada deixa porta aberta pra multi-org no futuro.
model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  timezone  String   @default("America/Sao_Paulo")
  /// Perfil público — campos opcionais usados em landing/email (ADR-012).
  phoneE164       String? @map("phone_e164")
  addressLine     String? @map("address_line")
  instagramHandle String? @map("instagram_handle")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organizations Organization[]
  memberships   TenantMembership[]

  @@map("tenants")
}

/// Membership: quem tem acesso ao tenant e em que papéis.
/// roles é array para suportar dono-que-também-é-barbeiro (ADR-001).
model TenantMembership {
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  roles     String[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId])
  @@index([tenantId])
  @@map("tenant_memberships")
}

/// Organization = marca/CNPJ. Maioria dos tenants tem 1 só.
/// Hierarquia preserva possibilidade de chain (Sprint 7+).
model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  description String?
  logoUrl     String?  @map("logo_url")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locations Location[]

  @@index([tenantId])
  @@map("organizations")
}

/// Location = endereço físico (uma unidade pode ter várias barbearias dentro,
/// mas no MVP é 1:1).
model Location {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  addressLine1   String  @map("address_line_1")
  addressLine2   String? @map("address_line_2")
  city           String
  state          String  @db.VarChar(2)
  postalCode     String  @map("postal_code")
  country        String  @default("BR") @db.VarChar(2)
  lat            Decimal? @db.Decimal(10, 7)
  lng            Decimal? @db.Decimal(10, 7)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  barbershops  Barbershop[]

  @@index([tenantId])
  @@index([organizationId])
  @@map("locations")
}

/// Barbershop = unidade operacional. Tem horários, serviços, funcionários.
model Barbershop {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  locationId  String   @map("location_id") @db.Uuid
  name        String
  description String?
  /// Rating agregado (cache; fonte = tabela reviews). ADR-019 §2.
  ratingAvg   Float?   @map("rating_avg")
  ratingCount Int      @default(0) @map("rating_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  location     Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  hours        BarbershopHours[]
  services     Service[]
  employees    Employee[]
  appointments Appointment[]
  reviews      Review[]

  @@index([tenantId])
  @@index([locationId])
  @@map("barbershops")
}

/// Janelas de funcionamento. Múltiplas linhas por weekday permitem
/// horário com intervalo (ex: 9-12 e 14-19).
model BarbershopHours {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  barbershopId String   @map("barbershop_id") @db.Uuid
  weekday      Int      // 0=domingo, 1=segunda, ..., 6=sábado
  opensAt      String   @map("opens_at") // HH:MM
  closesAt     String   @map("closes_at") // HH:MM
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([barbershopId, weekday])
  @@map("barbershop_hours")
}

/// Catálogo de serviços por barbershop. Preços em centavos (BRL).
///
/// bufferMin: tempo após o serviço durante o qual o barbeiro fica
/// indisponível (limpeza, pausa). Default 0 — barbershops simples não
/// precisam disso. SlotsService.compute() considera no overlap check
/// (ADR-005 §8).
model Service {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  barbershopId   String  @map("barbershop_id") @db.Uuid
  name           String
  description    String?
  durationMin    Int     @map("duration_min")
  bufferMin      Int     @default(0) @map("buffer_min")
  basePriceCents Int     @map("base_price_cents")
  isActive       Boolean @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  barbershop   Barbershop                @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  capabilities BarberServiceCapability[]
  appointments Appointment[]

  @@index([tenantId])
  @@index([barbershopId])
  @@map("services")
}

/// Funcionário (barbeiro ou admin). appUserId nulável: linhas existem
/// antes do convite ser aceito (vincula no aceite).
/// role: 'barber' | 'admin' | 'admin_barber'.
model Employee {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  barbershopId String   @map("barbershop_id") @db.Uuid
  appUserId    String?  @map("app_user_id") @db.Uuid
  displayName  String   @map("display_name")
  email        String?
  role         String
  isActive     Boolean  @default(true) @map("is_active")
  /// Rating agregado (cache; fonte = tabela reviews). ADR-019 §2.
  ratingAvg    Float?   @map("rating_avg")
  ratingCount  Int      @default(0) @map("rating_count")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  barbershop   Barbershop                @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appUser      AppUser?                  @relation(fields: [appUserId], references: [id], onDelete: SetNull)
  capabilities BarberServiceCapability[]
  schedules    BarberSchedule[]
  appointments Appointment[]
  timeOff      BarberTimeOff[]
  reviews      Review[]

  @@index([tenantId])
  @@index([barbershopId])
  @@index([appUserId])
  @@map("employees")
}

/// Agenda semanal do barbeiro. Múltiplas linhas/weekday cobrem intervalo
/// (ex: manhã 9-12 e tarde 14-19). Sprint 3 (slots) intercepta com
/// BarbershopHours pra calcular disponibilidade real.
/// BarberTimeOff (férias/folgas) deferido pra Sprint 5+ (ADR-003 §2).
model BarberSchedule {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  barberId  String   @map("barber_id") @db.Uuid
  weekday   Int      // 0=domingo, 1=segunda, ..., 6=sábado
  opensAt   String   @map("opens_at") // HH:MM
  closesAt  String   @map("closes_at") // HH:MM
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  barber Employee @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([barberId, weekday])
  @@map("barber_schedules")
}

/// Período de indisponibilidade do barbeiro (férias, folga, doença).
/// Sprint 7 introduz com schema simples — sem recorrência ainda.
/// SlotsService subtrai do working ranges; booking público é bloqueado
/// no overlap. Ao criar, admin recebe modal pra cancelar appointments
/// no range (ADR-008 §5).
model BarberTimeOff {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  barberId  String   @map("barber_id") @db.Uuid
  startAt   DateTime @map("start_at") @db.Timestamptz(6)
  endAt     DateTime @map("end_at") @db.Timestamptz(6)
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  barber Employee @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([barberId, startAt, endAt])
  @@map("barber_time_off")
}

/// Capability M:N — quais services um barbeiro atende.
/// Per-barber price/duration override fica deferido (ADR-003 §3).
model BarberServiceCapability {
  tenantId  String   @map("tenant_id") @db.Uuid
  barberId  String   @map("barber_id") @db.Uuid
  serviceId String   @map("service_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  barber  Employee @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@index([tenantId])
  @@index([serviceId])
  @@map("barber_service_capabilities")
}

/// Idempotency key — pra POSTs públicos retentáveis.
///
/// Cliente gera UUID antes de mandar booking. Backend cacheia
/// (request_hash, response_status, response_body). Mesma key + mesmo
/// hash retorna response cacheado; mesma key + hash diferente → 422.
///
/// RLS bypass: endpoint público (mesmo padrão do slots — ADR-004 §5).
/// App-level garante scoping por tenant_id no SELECT.
model IdempotencyKey {
  key             String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  requestHash     String   @map("request_hash")
  responseStatus  Int      @map("response_status")
  responseBody    Json     @map("response_body")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("idempotency_keys")
}

/// Appointment = horário reservado por um cliente com um barbeiro.
/// Sprint 3 introduz o modelo; endpoint de criação (POST) entra
/// no Sprint 4 — por enquanto, populado via seed pra testar slots.
///
/// end_at é armazenado (não derivado) pra blindar contra mudança de
/// service.duration_min depois do appointment ser criado (ADR-004 §3).
///
/// status: 'booked' | 'cancelled' | 'completed' | 'no_show'.
/// Slots subtraem só os com status='booked'.
model Appointment {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  barbershopId   String    @map("barbershop_id") @db.Uuid
  barberId       String    @map("barber_id") @db.Uuid
  serviceId      String    @map("service_id") @db.Uuid
  /// Null em booking guest; preenchido quando cliente logado reserva (ADR-016 §2)
  customerId     String?   @map("customer_id") @db.Uuid
  customerName   String    @map("customer_name")
  customerPhone  String?   @map("customer_phone")
  customerEmail  String?   @map("customer_email")
  startAt        DateTime  @map("start_at") @db.Timestamptz(6)
  endAt          DateTime  @map("end_at") @db.Timestamptz(6)
  /// Snapshot do preço no momento do booking (centavos). ADR-016 §5.
  priceCents     Int       @default(0) @map("price_cents")
  /// awaiting_payment | pending | confirmed | completed | cancelled | expired | no_show
  status         String    @default("awaiting_payment")
  /** 'customer' | 'admin' | 'system'. Null se não cancelado. */
  cancelledBy    String?   @map("cancelled_by")
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReason   String?   @map("cancel_reason")
  /** Quando o reminder email foi disparado (idempotência do worker). */
  reminderSentAt DateTime? @map("reminder_sent_at") @db.Timestamptz(6)
  /** Prazo pro barbeiro confirmar; min(booking+1h, startAt). ADR-017 §1. */
  confirmDeadline DateTime? @map("confirm_deadline") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barber     Employee   @relation(fields: [barberId], references: [id], onDelete: Restrict)
  service    Service    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  payment    Payment?
  review     Review?

  @@index([tenantId])
  @@index([barberId, startAt])
  @@index([barbershopId, startAt])
  @@index([status])
  @@index([customerId])
  @@map("appointments")
}

/// Pagamento de um appointment. Payment-ready desde o mock (ADR-016 §5).
/// provider='mock' aprova na hora; PSP real (S21) faz pending→paid via webhook.
model Payment {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  appointmentId     String    @unique @map("appointment_id") @db.Uuid
  /// 'mock' | 'mercadopago' | 'asaas'
  provider          String    @default("mock")
  /// 'pix' | 'credit' | 'debit' | 'wallet'
  method            String
  /// 'pending' | 'paid' | 'failed' | 'refunded' | 'expired'
  status            String    @default("pending")
  /// Total cobrado do cliente (serviço + taxa do método)
  amountCents       Int       @map("amount_cents")
  /// Taxa do método paga pelo cliente (Pix~0, débito~2%, crédito~5%)
  feeCents          Int       @default(0) @map("fee_cents")
  /// Comissão da plataforma (split futuro; calculada mas não cobrada no mock)
  platformFeeCents  Int       @default(0) @map("platform_fee_cents")
  /// ID do pagamento no PSP (mock gera fake)
  providerPaymentId String?   @map("provider_payment_id")
  /// Resposta/webhook do PSP (auditoria + reconciliação)
  providerPayload   Json?     @map("provider_payload")
  paidAt            DateTime? @map("paid_at") @db.Timestamptz(6)
  /// Quando foi estornado (recusa/expiração). ADR-017 §4.
  refundedAt        DateTime? @map("refunded_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([providerPaymentId])
  @@map("payments")
}

/// Perfil de cliente final (ADR-016 §2). 1:1 com AppUser.
/// NÃO tenant-scoped — cliente reserva em N barbearias com a mesma conta,
/// igual CustomerDevice. Acesso via role bypassRLS + filtro explícito.
model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  appUserId   String   @unique @map("app_user_id") @db.Uuid
  displayName String   @map("display_name")
  phoneE164   String?  @map("phone_e164")
  /// Total de cortes concluídos (cache; fonte = appointments completed). ADR-019 §3.
  completedCutsCount Int @default(0) @map("completed_cuts_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  appUser      AppUser       @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  reviews      Review[]

  @@map("customers")
}

/// Avaliação de um appointment concluído (ADR-019 §1). 1 por appointment.
/// Tenant-scoped (RLS); cliente escreve via bypassRLS + filtro explícito.
/// rating 1..5; agregados em Employee/Barbershop recomputados na escrita.
model Review {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  appointmentId String   @unique @map("appointment_id") @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  barberId      String   @map("barber_id") @db.Uuid
  barbershopId  String   @map("barbershop_id") @db.Uuid
  rating        Int
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  barber      Employee    @relation(fields: [barberId], references: [id], onDelete: Cascade)
  barbershop  Barbershop  @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([barberId])
  @@index([barbershopId])
  @@index([customerId])
  @@map("reviews")
}

/// Devices registrados pro Expo Push Service (ADR-010 §5/§8).
/// Sem RLS — cliente reserva em N barbearias com o mesmo telefone/email,
/// então não pertence a tenant específico. Filtros são por customerPhone.
model CustomerDevice {
  id            String   @id @default(uuid()) @db.Uuid
  expoPushToken String   @unique @map("expo_push_token")
  customerPhone String   @map("customer_phone")
  lastSeenAt    DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([customerPhone])
  @@map("customer_devices")
}

/// Devices push do BARBEIRO/admin (ADR-017 §6). Espelha CustomerDevice
/// mas ligado ao AppUser (barbeiro é sempre logado), não ao telefone.
/// Recebe push de novo 'pending' pra confirmar. Sem RLS (não tenant-scoped).
model EmployeeDevice {
  id            String   @id @default(uuid()) @db.Uuid
  appUserId     String   @map("app_user_id") @db.Uuid
  expoPushToken String   @unique @map("expo_push_token")
  lastSeenAt    DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([appUserId])
  @@map("employee_devices")
}
