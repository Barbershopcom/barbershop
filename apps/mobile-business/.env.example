# --- Supabase ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- API backend ---
# Em dev local com Expo Go, use o IP da máquina (10.0.0.x), não localhost
EXPO_PUBLIC_API_URL=http://localhost:3333

# --- Observability (Sprint 13 / ADR-014) ---
# Sem DSN, Sentry é no-op. Em prod configure no eas.json profile env.
EXPO_PUBLIC_SENTRY_DSN=
